{
  "name": "gc-orders",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check:portability": "node scripts/check-portability.mjs",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/seed.ts",
    "dev:setup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dev-db.ts setup",
    "db:up": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dev-db.ts up",
    "db:down": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dev-db.ts down",
    "db:reset": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dev-db.ts reset"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24 <25"
  }
}
