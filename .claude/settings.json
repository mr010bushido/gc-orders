{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm dev)",
      "Bash(pnpm lint *)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test *)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(pnpm check:portability)",
      "Bash(openspec *)",
      "Bash(graphify *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin main *)",
      "Bash(git push origin main)",
      "Bash(git push origin develop *)",
      "Bash(git push origin develop)",
      "Bash(git push --tags *)",
      "Bash(git tag *)",
      "Bash(gh release *)",
      "Bash(vercel *)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production*)"
    ]
  }
}
