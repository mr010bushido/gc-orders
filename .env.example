# Local development: `pnpm dev:setup` writes .env.local with local values and a random JOBS_SECRET.
JOBS_SECRET=

# Runtime: pooled connection URL. Local-only value from compose.yaml (dev database, port 5435):
# postgres://cakes:local-cakes-only@127.0.0.1:5435/cakes
# The disposable test database (docker compose --profile test) is on port 5436, database cakes_test.
DATABASE_URL=
# Migrations: direct or session pooler URL, never the transaction pooler.
# On IPv4-only hosts use Supabase's session pooler instead of its IPv6 direct URL.
# If unset, db:migrate falls back to DATABASE_URL. Run migrations manually.
DATABASE_MIGRATION_URL=
# Optional positive integer; defaults to 1 per instance. Increase on the VPS.
# DATABASE_POOL_MAX=1

# Notifications. Without all three Twilio values SMS goes to the console sender; without both Resend values email does.
# Credentials come from the owner and are set by a human in the host's environment, never committed.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
RESEND_API_KEY=
EMAIL_FROM=
# Owner alert email. The owner alert phone is the owner_alert_phone setting.
OWNER_EMAIL=
# Supabase public project configuration for owner login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public origin used in customer order links, e.g. https://orders.example.com (no trailing slash). Local: http://localhost:3000
APP_URL=
